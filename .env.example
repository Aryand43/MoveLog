# ---- runtime ----
PORT=8080
PHOTOS_DIR=./photos                 # /photos on Modal (Volume mount)
PUBLIC_BASE_URL=                    # https tunnel URL in dev, Modal URL in prod. No trailing slash.

# ---- OpenAI (gpt-live-1 voice + gpt-5.6-luna backend/vision) ----
OPENAI_API_KEY=

# ---- CopilotKit Channels (managed Intelligence tier) ----
COPILOTKIT_API_KEY=                 # cpk-... from intelligence.copilotkit.ai -> project -> API Keys

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=                 # from BotFather
TELEGRAM_BOT_USERNAME=              # without @, used for t.me deep links
OPS_CHAT_ID=                        # negative id of the "Ops - Moves" group (captured in Phase 1)

# ---- ClickHouse Cloud ----
CLICKHOUSE_URL=                     # https://<host>.clickhouse.cloud:8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=movelog
CLICKHOUSE_RO_USER=movelog_ro       # readonly=1 user, used only by the run_select ops tool
CLICKHOUSE_RO_PASSWORD=

# ---- Phase 7b only ----
TRIGGER_SECRET_KEY=

# ---- Next.js frontend (apps/web/.env.local, and Vercel project env) ----
# NEXT_PUBLIC_API_URL=https://<workspace>--movelog-backend-dev.modal.run
